{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.associations": {
      "*.rpgle": "rpgle",
      "*.sqlrpgle": "sqlrpgle",
      "*.rpgleinc": "rpgle",
      "*.bnd": "bnd",
      "*.bnddir": "bnddir"
    },
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.eol": "\n",
    "code-for-ibmi.connectionSettings.autoSortIFSShortcuts": true
  },
  "extensions": {
    "recommendations": [
      "halcyontechltd.code-for-ibmi",
      "halcyontechltd.vscode-ibmi-languages",
      "halcyontechltd.vscode-rpgle",
      "barrettotte.ibmi-languages"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install dependencies",
        "type": "shell",
        "command": "python",
        "args": ["install_deps.py"],
        "problemMatcher": []
      }
    ]
  }
}
